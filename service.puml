@startuml RankUp_camadas_lr
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 40
left to right direction
hide empty members
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam ArrowColor #333333

package "controller" {
    class UsuarioController <<RestController>> {
      +cadastrar()
      +login()
      +perfil()
      +atualizar()
      +listar()
      +deletar()
    }
    class RegistroController <<RestController>> {
      +acoes()
      +registrar()
      +historico()
    }
    class RankingController <<RestController>> {
      +ranking()
      +posicao()
    }
}

package "service" {
    class UsuarioService <<Service>> {
      +cadastrar()
      +login()
      +buscarComHistorico()
      +atualizar()
      +listarTodos()
      +deletar()
    }
    class RegistroAcaoService <<Service>> {
      +registrar()
      +historico()
    }
    class RankingService <<Service>> {
      +top()
      +posicao()
    }
    class AcaoService <<Service>> {
      +listar()
      +buscarPorNome()
    }
    class "RankingService.Posicao" as Posicao <<record>>
}

package "mapper" {
    class UsuarioMapper {
      +{static} toResponse()
      +{static} toPerfil()
      +{static} toResumo()
      +{static} toRankingItem()
    }
    class RegistroMapper {
      +{static} toCriado()
      +{static} toHistorico()
    }
    class AcaoMapper {
      +{static} toResponse()
    }
}

package "dto" {
    class CadastroRequest <<record>>
    class LoginRequest <<record>>
    class AtualizarUsuarioRequest <<record>>
    class RegistroRequest <<record>>
    class UsuarioResponse <<record>>
    class UsuarioResumoResponse <<record>>
    class PerfilResponse <<record>>
    class AcaoResponse <<record>>
    class RegistroCriadoResponse <<record>>
    class HistoricoResponse <<record>>
    class RankingItemResponse <<record>>
}

package "exception" {
    class ApiException {
      -status: int
      +getStatus(): int
    }
    class TratadordeErros <<RestControllerAdvice>> {
      +tratar(e: ApiException)
    }
}

package "dao" {
    class UsuarioDAO
    class RegistroAcaoDAO
}
package "models" {
    class AcaoSustentavel
    class Ranking
}

' Controller -> Service
UsuarioController --> UsuarioService
RegistroController --> RegistroAcaoService
RegistroController --> AcaoService
RankingController --> RankingService

' Controller -> Mapper
UsuarioController ..> UsuarioMapper
RegistroController ..> RegistroMapper
RegistroController ..> AcaoMapper
RankingController ..> UsuarioMapper

' Controller -> DTO (entrada)
UsuarioController ..> CadastroRequest
UsuarioController ..> LoginRequest
UsuarioController ..> AtualizarUsuarioRequest
RegistroController ..> RegistroRequest

' Service -> Service / DAO / Models
RegistroAcaoService --> UsuarioService
RegistroAcaoService --> AcaoService
UsuarioService --> AcaoService
UsuarioService --> UsuarioDAO
UsuarioService --> RegistroAcaoDAO
RegistroAcaoService --> UsuarioDAO
RegistroAcaoService --> RegistroAcaoDAO
RankingService --> UsuarioDAO
RankingService --> Ranking
RankingService +-- Posicao
AcaoService --> AcaoSustentavel

' Mapper -> DTO
UsuarioMapper ..> UsuarioResponse
UsuarioMapper ..> PerfilResponse
UsuarioMapper ..> UsuarioResumoResponse
UsuarioMapper ..> RankingItemResponse
RegistroMapper ..> RegistroCriadoResponse
RegistroMapper ..> HistoricoResponse
AcaoMapper ..> AcaoResponse

' Exceptions
RuntimeException <|-- ApiException
UsuarioService ..> ApiException : lança
RegistroAcaoService ..> ApiException : lança
RankingService ..> ApiException : lança
TratadordeErros ..> ApiException : trata
@enduml