@startuml RankUp_camadas
skinparam classAttributeIconSize 0

package "controller" {
    class UsuarioController <<RestController>> {
      -usuarioService: UsuarioService
      +cadastrar(req: CadastroRequest): ResponseEntity<UsuarioResponse>
      +login(req: LoginRequest): UsuarioResponse
      +perfil(id: int): PerfilResponse
      +atualizar(id: int, req: AtualizarUsuarioRequest): UsuarioResponse
      +listar(idSolicitante: Integer): List<UsuarioResumoResponse>
      +deletar(idSolicitante: Integer, id: int): ResponseEntity<Void>
    }
    class RegistroController <<RestController>> {
      -registroAcaoBO: RegistroAcaoService
      -acaoBO: AcaoService
      +acoes(): List<AcaoResponse>
      +registrar(id: int, req: RegistroRequest): ResponseEntity<RegistroCriadoResponse>
      +historico(id: int): List<HistoricoResponse>
    }
    class RankingController <<RestController>> {
      -rankingService: RankingService
      +ranking(limite: int): List<RankingItemResponse>
      +posicao(id: int): RankingService.Posicao
    }
}

package "service" {
    class UsuarioService <<Service>> {
      -{static} CODIGO_ADMIN: String
      -usuarioDAO: UsuarioDAO
      -registroAcaoDAO: RegistroAcaoDAO
      -acaoBO: AcaoService
      +cadastrar(nome: String, email: String, idade: int, codigoAdmin: String): Usuario
      +login(email: String): Usuario
      +buscarComHistorico(id: int): Usuario
      +atualizar(id: int, nome: String, email: String, idade: int): Usuario
      +listarTodos(idSolicitante: Integer): List<Usuario>
      +deletar(idSolicitante: Integer, id: int): void
      -exigirAdmin(idSolicitante: Integer): void
      -validarCampos(nome: String, email: String, idade: int): void
    }
    class RegistroAcaoService <<Service>> {
      -usuarioBO: UsuarioService
      -acaoBO: AcaoService
      -usuarioDAO: UsuarioDAO
      -registroAcaoDAO: RegistroAcaoDAO
      +registrar(idUsuario: int, nomeAcao: String, quantidade: double, data: String): Usuario
      +historico(idUsuario: int): List<RegistroAcao>
    }
    class RankingService <<Service>> {
      -usuarioDAO: UsuarioDAO
      -ranking: Ranking
      +top(limite: int): List<Usuario>
      +posicao(idUsuario: int): Posicao
    }
    class "RankingService.Posicao" as Posicao <<record>> {
      +posicao: int
      +totalUsuarios: int
      +pontuacaoTotal: double
    }
    class AcaoService <<Service>> {
      -acoes: List<AcaoSustentavel>
      +listar(): List<AcaoSustentavel>
      +buscarPorNome(nome: String): AcaoSustentavel
    }
}

package "dto" {
    class CadastroRequest <<record>> {
      +nome: String
      +email: String
      +idade: int
      +codigoAdmin: String
    }
    class LoginRequest <<record>> {
      +email: String
    }
    class AtualizarUsuarioRequest <<record>> {
      +nome: String
      +email: String
      +idade: int
    }
    class RegistroRequest <<record>> {
      +nomeAcao: String
      +quantidade: double
      +data: String
    }
    class UsuarioResponse <<record>> {
      +id: int
      +nome: String
      +email: String
      +idade: int
      +tipo: String
    }
    class UsuarioResumoResponse <<record>> {
      +id: int
      +nome: String
      +email: String
      +idade: int
      +tipo: String
      +pontuacaoTotal: double
    }
    class PerfilResponse <<record>> {
      +id: int
      +nome: String
      +email: String
      +idade: int
      +tipo: String
      +pontuacaoTotal: double
      +nivel: String
      +co2TotalEvitado: double
    }
    class AcaoResponse <<record>> {
      +nome: String
      +descricao: String
      +unidade: String
      +pontosPorAcao: double
      +fatorCO2: double
    }
    class RegistroCriadoResponse <<record>> {
      +idRegistro: int
      +nomeAcao: String
      +quantidade: double
      +data: String
      +pontosGanhos: double
      +co2Evitado: double
      +pontuacaoTotal: double
      +nivel: String
    }
    class HistoricoResponse <<record>> {
      +idRegistro: int
      +nomeAcao: String
      +unidade: String
      +quantidade: double
      +data: String
      +pontos: double
      +co2Evitado: double
    }
    class RankingItemResponse <<record>> {
      +posicao: int
      +id: int
      +nome: String
      +pontuacaoTotal: double
    }
}

package "mapper" {
    class UsuarioMapper {
      +{static} toResponse(u: Usuario): UsuarioResponse
      +{static} toPerfil(u: Usuario): PerfilResponse
      +{static} toResumo(u: Usuario): UsuarioResumoResponse
      +{static} toRankingItem(posicao: int, u: Usuario): RankingItemResponse
    }
    class RegistroMapper {
      +{static} toCriado(r: RegistroAcao, u: Usuario): RegistroCriadoResponse
      +{static} toHistorico(r: RegistroAcao): HistoricoResponse
    }
    class AcaoMapper {
      +{static} toResponse(a: AcaoSustentavel): AcaoResponse
    }
}

package "exception" {
    class ApiException {
      -status: int
      +ApiException(status: int, mensagem: String)
      +getStatus(): int
    }
    class TratadordeErros <<RestControllerAdvice>> {
      +tratar(e: ApiException): ResponseEntity<Map<String, String>>
    }
}

' ===== Referencias externas (apenas nome) =====
package "dao" {
    class UsuarioDAO
    class RegistroAcaoDAO
}
package "models" {
    abstract class Usuario
    class RegistroAcao
    class AcaoSustentavel
    class Ranking
}

' ===== Controller -> Service =====
UsuarioController --> UsuarioService
RegistroController --> RegistroAcaoService
RegistroController --> AcaoService
RankingController --> RankingService

' ===== Service -> Service / DAO / Models =====
RegistroAcaoService --> UsuarioService
RegistroAcaoService --> AcaoService
UsuarioService --> AcaoService
UsuarioService --> UsuarioDAO
UsuarioService --> RegistroAcaoDAO
RegistroAcaoService --> UsuarioDAO
RegistroAcaoService --> RegistroAcaoDAO
RankingService --> UsuarioDAO
RankingService --> Ranking
RankingService +-- Posicao
AcaoService --> AcaoSustentavel

' ===== Controller -> Mapper =====
UsuarioController ..> UsuarioMapper
RegistroController ..> RegistroMapper
RegistroController ..> AcaoMapper
RankingController ..> UsuarioMapper

' ===== Controller -> DTO =====
UsuarioController ..> CadastroRequest
UsuarioController ..> LoginRequest
UsuarioController ..> AtualizarUsuarioRequest
UsuarioController ..> UsuarioResponse
UsuarioController ..> PerfilResponse
UsuarioController ..> UsuarioResumoResponse
RegistroController ..> RegistroRequest
RegistroController ..> RegistroCriadoResponse
RegistroController ..> HistoricoResponse
RegistroController ..> AcaoResponse
RankingController ..> RankingItemResponse

' ===== Mapper -> DTO / Models =====
UsuarioMapper ..> UsuarioResponse
UsuarioMapper ..> PerfilResponse
UsuarioMapper ..> UsuarioResumoResponse
UsuarioMapper ..> RankingItemResponse
UsuarioMapper ..> Usuario
RegistroMapper ..> RegistroCriadoResponse
RegistroMapper ..> HistoricoResponse
RegistroMapper ..> RegistroAcao
RegistroMapper ..> Usuario
AcaoMapper ..> AcaoResponse
AcaoMapper ..> AcaoSustentavel

' ===== Exceptions =====
RuntimeException <|-- ApiException
UsuarioService ..> ApiException : lança
RegistroAcaoService ..> ApiException : lança
RankingService ..> ApiException : lança
TratadordeErros ..> ApiException : trata

@enduml