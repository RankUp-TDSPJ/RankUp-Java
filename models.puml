@startuml RankUp_models
skinparam classAttributeIconSize 0

package "interfaces" {
    interface Exibivel {
      +exibir(): void
    }
}

package "enums" {
    enum Classificacao {
      SUSTENTAVEL
      NAOSUSTENTAVEL
    }
}

package "models" {

    abstract class Usuario {
      -id: int
      -nome: String
      -email: String
      -idade: int
      -pontuacao: PontuacaoUsuario
      +Usuario(nome: String, email: String, idade: int)
      +exibirPerfil(): void
      +exibir(): void
      +{abstract} getTipo(): String
      +{abstract} exibirPermissoes(): void
    }
    note right of Usuario : getters e setters gerados\npelo Lombok (@Getter/@Setter)

    class UsuarioComum {
      +getTipo(): String
      +exibirPermissoes(): void
    }

    class UsuarioAdmin {
      +getTipo(): String
      +exibirPermissoes(): void
      +visualizarTodosUsuarios(usuarios: List<Usuario>): void
    }

    class PontuacaoUsuario {
      -pontuacaoTotal: double
      -registros: List<RegistroAcao>
      +adicionarRegistro(registro: RegistroAcao): void
      +carregarRegistros(registrosCarregados: List<RegistroAcao>): void
      +exibirPontuacao(): void
      +exibir(): void
      +contarTiposDistintos(): int
      +calcularNivel(): String
      +calcularCo2TotalEvitado(): double
      +getRegistros(): List<RegistroAcao>
      +getPontuacaoTotal(): double
      +setPontuacaoTotal(pontuacaoTotal: double): void
    }

    class RegistroAcao {
      -id_acao: int
      -acao: AcaoSustentavel
      -quantidade: double
      -data: String
      +RegistroAcao(acao: AcaoSustentavel, quantidade: double, data: String)
      +calcularImpactoCO2(): double
      +calcularPontos(): double
      +exibirRegistro(): void
    }
    note right of RegistroAcao : getters e setters gerados\npelo Lombok (@Getter/@Setter)

    class CalculadoraCarbono {
      -{static} fatorEmissao: double
      +{static} calcularImpacto(acao: AcaoSustentavel, quantidade: double): double
      +{static} avaliarAcao(acao: AcaoSustentavel, quantidade: double): int
      +getFatorEmissao(): double
      +setFatorEmissao(fatorEmissao: double): void
    }

    abstract class Acao {
      -nome: String
      -descricao: String
      -classificacao: Classificacao
      +Acao(nome: String, descricao: String, classificacao: Classificacao)
      +{abstract} exibirAcao(): void
      +getNome(): String
      +setNome(nome: String): void
      +getDescricao(): String
      +setDescricao(descricao: String): void
      +getClassificacao(): Classificacao
      +setClassificacao(classificacao: Classificacao): void
    }

    class AcaoSustentavel {
      -fatorCO2: double
      -pontosPorAcao: double
      -unidade: String
      +exibirAcao(): void
      +exibir(): void
      +getFatorCO2(): double
      +getPontosPorAcao(): double
      +getUnidade(): String
    }

    class Ranking {
      +gerarRanking(usuarios: List<Usuario>): List<Usuario>
      +posicaoUsuario(userAlvo: Usuario, usuarios: List<Usuario>): int
    }
}

' ===== Implementacao de interface =====
Usuario ..|> Exibivel
PontuacaoUsuario ..|> Exibivel
AcaoSustentavel ..|> Exibivel

' ===== Heranca =====
Usuario <|-- UsuarioComum
Usuario <|-- UsuarioAdmin
Acao <|-- AcaoSustentavel

' ===== Composicao / associacao =====
Usuario *-- PontuacaoUsuario
PontuacaoUsuario *-- "0..*" RegistroAcao
RegistroAcao --> AcaoSustentavel
Acao --> Classificacao

' ===== Dependencias =====
CalculadoraCarbono ..> AcaoSustentavel : usa
Ranking ..> Usuario : usa
UsuarioAdmin ..> Usuario : visualiza

@enduml